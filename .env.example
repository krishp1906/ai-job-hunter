# AI JobHunter Environment Variables

# Database Connection (SQLite default for zero-friction local setup, PostgreSQL supported)
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (Server-side ONLY. Never expose with NEXT_PUBLIC_ prefix!)
GEMINI_API_KEY=""

# Gemini Model Selection (e.g. gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL="gemini-2.0-flash"

# Port configuration
PORT=3000
